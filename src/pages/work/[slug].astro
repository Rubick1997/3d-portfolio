---
import type { GetStaticPaths } from "astro";
import Base from "@/layouts/Base.astro";
import PageHeader from "@/components/PageHeader.astro";
import Tags from "@/components/Tags.astro";
import Arrow from "@/components/Arrow.astro";
import ContactCard from "@/components/ContactCard.astro";
import Colophon from "@/components/Colophon.astro";
import { work, type CaseStudy } from "@/data/work";
import { breadcrumbs, personId } from "@/lib/jsonld";
import { site } from "@/data/profile";
import BitmaskDemo from "@/components/demos/BitmaskDemo.astro";
import FocalDemo from "@/components/demos/FocalDemo.astro";

export const getStaticPaths = (() => work.map((w) => ({ params: { slug: w.slug }, props: { w } }))) satisfies GetStaticPaths;

const { w } = Astro.props as { w: CaseStudy };
const next = work[(work.indexOf(w) + 1) % work.length];
const demo = ({ "llm-output-as-build-artifact": "bitmask", "face-aware-hero-banners": "focal" } as Record<string, string>)[w.slug];

const blocks: [string, string[] | undefined][] = [
  ["Problem", w.problem],
  ["Constraints", w.constraints],
  ["Approach", w.approach],
];
const after: [string, string[] | undefined][] = [
  ["Results", w.results],
  ["What went wrong", w.failures],
  ["What I'd do differently", w.differently],
];
const h2 = "font-mono text-xs font-medium uppercase tracking-[0.18em] text-subtle";
---

<Base
  title={w.title}
  description={w.summary}
  path={`/work/${w.slug}`}
  ogImage={`/og/work/${w.slug}.png`}
  ogType="article"
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "@id": `${site.url}/work/${w.slug}#article`,
      headline: w.title,
      description: w.summary,
      url: `${site.url}/work/${w.slug}`,
      image: `${site.url}/og/work/${w.slug}.png`,
      author: { "@type": "Person", "@id": personId, name: site.name, url: `${site.url}/` },
      about: w.stack,
      inLanguage: "en-US",
    },
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Work", path: "/#work" },
      { name: w.title, path: `/work/${w.slug}` },
    ]),
  ]}
>
  <PageHeader />
  <main id="content" class="mx-auto max-w-3xl px-4 pb-16 pt-12 sm:px-6 sm:pt-16">
    <article>
      <header class="hero-panel -mx-1 p-7 sm:-mx-6 sm:p-10">
        <canvas data-flow></canvas>
        <p class="hp-subtle font-mono text-xs uppercase tracking-wide">{w.org} · {w.kicker}</p>
        <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{w.title}</h1>
        <p class="hp-muted mt-4 text-lg">{w.summary}</p>
        {
          w.metrics.length > 0 && (
            <dl class="mt-10 grid grid-cols-2 gap-y-6 border-t border-white/10 pt-6 sm:grid-cols-4">
              {w.metrics.map((m, i) => (
                <div class:list={["pr-4", i % 2 === 1 && "max-sm:border-l max-sm:border-white/10 max-sm:pl-4", i > 0 && "sm:border-l sm:border-white/10 sm:pl-4"]}>
                  <dt class="sr-only">{m.label}</dt>
                  <dd class="stat-num text-gradient text-2xl sm:text-[1.7rem]">{m.value}</dd>
                  <dd class="hp-subtle mt-2 text-xs leading-snug">{m.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </header>

      {demo === "bitmask" && <BitmaskDemo />}
      {demo === "focal" && <FocalDemo />}

      <div class="text-[1.0625rem] text-muted [&_p]:max-w-prose">
        {
          blocks.map(
            ([title, items]) =>
              !!items?.length && (
                <section class="mt-12">
                  <h2 class={h2}>{title}</h2>
                  <div class="mt-4 space-y-4">{items.map((p) => <p>{p}</p>)}</div>
                </section>
              ),
          )
        }

        {
          w.decision && (
            <section class="mt-12 rounded-[var(--radius-card)] border-l-2 border-accent bg-surface p-6">
              <h2 class="font-mono text-xs font-medium uppercase tracking-[0.18em] text-accent">Key decision</h2>
              <h3 class="mt-2 font-medium text-text">{w.decision.title}</h3>
              <div class="mt-3 space-y-3">{w.decision.body.map((p) => <p>{p}</p>)}</div>
            </section>
          )
        }

        {
          after.map(
            ([title, items]) =>
              !!items?.length && (
                <section class="mt-12">
                  <h2 class={h2}>{title}</h2>
                  <div class="mt-4 space-y-4">{items.map((p) => <p>{p}</p>)}</div>
                </section>
              ),
          )
        }

        {
          w.lesson && (
            <blockquote class="mt-12 border-l-2 border-border pl-5 text-xl font-medium leading-snug text-text">
              &ldquo;{w.lesson}&rdquo;
            </blockquote>
          )
        }

        <section class="mt-12">
          <h2 class={h2}>Stack</h2>
          <Tags items={w.stack} />
        </section>

        {
          w.related.length > 0 && (
            <section class="mt-12">
              <h2 class={h2}>Related writing</h2>
              <ul class="mt-4 space-y-2">
                {w.related.map((r) => (
                  <li>
                    <a href={r.href} class="link group" target="_blank" rel="noreferrer">
                      {r.title} <Arrow />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </article>

    <div class="mt-20"><ContactCard /></div>

    <nav aria-label="Case studies" class="mt-12 flex justify-between gap-4 text-sm">
      <a href="/#work" class="link">← All work</a>
      <a href={`/work/${next.slug}`} class="link group text-right">Next: {next.title} <Arrow /></a>
    </nav>

    <Colophon />
  </main>
</Base>
