---
// Interactive version of the "precompute the whole space" idea, using the made-up shop
// from the article (never the real product). It computes the file a page would fetch.
const filters = [
  "Waterproof", "Vegan materials", "Lightweight", "Wide fit", "Recycled", "Under $100",
  "Trail", "Breathable", "Slip-on", "Insulated", "Reflective", "Machine washable",
];
---

<section class="demo mt-10 rounded-2xl border border-border bg-surface p-6 sm:p-8" data-bitmask aria-labelledby="bm-title">
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">Try it</p>
  <h2 id="bm-title" class="mt-1 text-xl font-semibold text-text">Every selection is a file that already exists</h2>
  <p class="mt-2 max-w-prose text-sm text-muted">
    The made-up shop from the article: 12 filters, so 2¹² − 1 = 4,095 possible selections. Pick any filters and see
    which precomputed file the page fetches.
  </p>

  <div class="mt-6 flex flex-wrap gap-2" role="group" aria-label="Shop filters">
    {
      filters.map((f, i) => (
        <button
          type="button"
          data-bit={i}
          aria-pressed="false"
          class="rounded-full border border-border px-3 py-1.5 text-sm text-muted transition hover:border-accent hover:text-text aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-white"
        >
          {f}
        </button>
      ))
    }
  </div>

  <div class="mt-6 grid gap-4 rounded-xl bg-[#0b0e13] p-5 font-mono text-sm text-[#e7e9ec] sm:grid-cols-[auto_1fr] sm:items-center">
    <div class="flex gap-1" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => <span data-cell={11 - i} class="h-6 w-4 rounded-sm bg-white/10 transition-colors" />)}
    </div>
    <div aria-live="polite">
      <p><span class="text-[#8a94a1]">mask</span> = <span data-mask class="text-[#f5c26b]">0</span></p>
      <p class="truncate"><span class="text-[#8a94a1]">fetch</span> <span data-path class="text-[#f0905f]">pick a filter</span></p>
    </div>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-4 text-sm sm:grid-cols-3">
    <div class="rounded-lg border border-border p-3">
      <dt class="text-xs text-subtle">Before (V1)</dt>
      <dd class="mt-1 font-mono text-text">31 s · 11 data + 7 model calls</dd>
    </div>
    <div class="rounded-lg border border-accent/40 p-3">
      <dt class="text-xs text-subtle">After</dt>
      <dd class="mt-1 font-mono text-accent">one ~2 KB static file</dd>
    </div>
    <div class="col-span-2 rounded-lg border border-border p-3 sm:col-span-1">
      <dt class="text-xs text-subtle">Model calls at request time</dt>
      <dd class="mt-1 font-mono text-text">0</dd>
    </div>
  </dl>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-bitmask]").forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-bit]")];
    const cells = [...root.querySelectorAll<HTMLElement>("[data-cell]")];
    const maskEl = root.querySelector("[data-mask]")!;
    const pathEl = root.querySelector("[data-path]")!;
    const update = () => {
      // Same encoding as the article: filter n sets bit n.
      const mask = buttons.reduce((m, b) => (b.getAttribute("aria-pressed") === "true" ? m | (1 << Number(b.dataset.bit)) : m), 0);
      cells.forEach((c) => {
        const on = (mask >> Number(c.dataset.cell)) & 1;
        c.style.background = on ? "#f0905f" : "";
      });
      maskEl.textContent = `${mask}  (0b${mask.toString(2).padStart(12, "0")})`;
      pathEl.textContent = mask ? `/api/writeup/${mask}.json` : "pick a filter";
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        b.setAttribute("aria-pressed", String(b.getAttribute("aria-pressed") !== "true"));
        update();
      }),
    );
    buttons[0]?.click();
    buttons[1]?.click();
  });
</script>
